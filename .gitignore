scripts/capture-figma-store.js

# Mind2Web experiment — local experiment data, not repo material
tests/mind2web-experiment/

# Mind2Web full train split — 13GB raw_html corpus, download locally.
# Pooled-stat caches are regenerated per config_hash via
# scripts/mind2web-extract-task.js. See docs/stage9-mind2web-validation.md.
data/mind2web/
data/mind2web-cache-*/
# Keep split manifest tracked
!data/mind2web-split.json

# Coco-Search18 image dataset — large, download locally
data/coco-search18/images/

# Local scratch output — regenerated artifacts, not repo material
output/

# Temporal-variance capture artifacts — PNG stacks + report, regenerate via
# `npm run test:temporal-variance`. Too large + machine-specific for git.
tests/temporal-variance/

# Pyramid validation reference data — regenerate with generate-pyramid-reference.py
tests/validation/pyramid-reference/

# Isotropic comparison captures — bulk PNGs, regenerate with capture-isotropic-comparison.js
docs/golden/isotropic-comparison/

# Capture pipeline manifests (per-directory skip cache)
.capture-manifest.json

# OCR test artifacts
*.traineddata
tests/validation/ocr-accuracy-curve.json
# Eye-tracking datasets (large downloads, not for git)
# Keep demo samples (data/*/demo-*.json) for out-of-box replay
data/coco-search18/*.zip
